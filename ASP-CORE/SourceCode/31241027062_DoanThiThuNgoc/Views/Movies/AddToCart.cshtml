@model _31241027062_DoanThiThuNgoc.Models.HoaDon
@{
    ViewBag.Title = "Giỏ hàng";
    var vi = new System.Globalization.CultureInfo("vi-VN");
}
<h3 class="section-title mb-4">Giỏ hàng của bạn</h3>
<table id="cartTable" class="table align-middle">
    <thead>
        <tr>
            <th>Số lượng</th>
            <th>Sản phẩm</th>
            <th class="text-end">Giá</th>
            <th class="text-end">Thành tiền</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hoaDonChiTiet in Model.ChiTietHoaDons)
        {
            <tr>
                <td class="text-center">@hoaDonChiTiet.SoLuong</td>
                <td class="text-start">@hoaDonChiTiet.MovieObj.Title</td>
                <td class="text-end">@hoaDonChiTiet.MovieObj.Price.ToString("N0", vi) đ</td>
                <td class="text-end">@((hoaDonChiTiet.SoLuong * hoaDonChiTiet.MovieObj.Price).ToString("N0", vi)) đ</td>
                <td class="text-end">
                    <form asp-action="RemoveFromCart" asp-route-maMovies="@hoaDonChiTiet.MaMovie" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-warning">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="3" class="text-end fw-bold">Total:</td>
            <td class="text-end price fs-5">@Model.TongTien.ToString("N0", vi) đ</td>
            <td></td>
        </tr>
    </tfoot>
</table>
<div class="d-flex justify-content-center gap-2 mt-4">
    <a class="btn btn-outline-light" asp-action="Index">Continue shopping</a>
    <a class="btn btn-accent" asp-action="Checkout">Checkout now</a>
</div>