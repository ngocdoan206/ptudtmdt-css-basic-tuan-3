@model _31241027062_DoanThiThuNgoc.Models.Movie
@using System.Globalization
@{
    ViewData["Title"] = Model.Title;
    var vi = new CultureInfo("vi-VN");
}

<div class="detail-hero">
    <div class="hero-bg" style="background-image: url('@Model.PicturePath')"></div>
    <div class="detail-content">
        <img class="detail-poster" src="@Model.PicturePath" alt="@Model.Title" />
        <div>
            <h1 class="detail-title">@Model.Title</h1>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge badge-genre">@Model.GenreObj?.Name</span>
                <span class="badge text-bg-dark border">@Model.ReleaseDate.Year</span>
                <span class="badge text-bg-dark border">★ @Model.Rated/5</span>
            </div>
            <p class="detail-summary">@Model.Summary</p>
            <dl class="detail-meta">
                <dt>Khởi chiếu</dt>
                <dd>@Model.ReleaseDate.ToString("dd/MM/yyyy")</dd>
                <dt>Thể loại</dt>
                <dd>@Model.GenreObj?.Name</dd>
                <dt>Giá</dt>
                <dd class="price">@Model.Price.ToString("N0", vi) đ</dd>
            </dl>
            <div class="d-flex flex-wrap gap-2">
                <form asp-action="AddToCart" asp-route-id="@Model.ID" method="post">
                    <button type="submit" class="btn btn-accent px-4">Mua</button>
                </form>
                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-outline-light">Sửa</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</div>